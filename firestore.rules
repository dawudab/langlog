rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 3. Entity Validation Blueprints
    function isValidJournalEntry(data) {
      return data.keys().hasAll([
          'userId',
          'originalText',
          'fullArabicTranslation',
          'tokens',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'originalText',
          'fullArabicTranslation',
          'tokens',
          'createdAt',
          'updatedAt'
        ])
        && data.userId is string
        && data.userId.size() >= 1
        && data.userId.size() <= 128
        && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId == request.auth.uid
        && data.originalText is string
        && data.originalText.size() >= 1
        && data.originalText.size() <= 10000
        && data.fullArabicTranslation is string
        && data.fullArabicTranslation.size() >= 1
        && data.fullArabicTranslation.size() <= 15000
        && data.tokens is list
        && data.tokens.size() <= 80
        && (data.tokens.size() == 0 || data.tokens[0] is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWordBankItem(data) {
      return data.keys().hasAll([
          'userId',
          'arabicWord',
          'normalizedWord',
          'englishMeaning',
          'transliteration',
          'root',
          'partOfSpeech',
          'contextSentenceArabic',
          'contextSentenceEnglish',
          'visualKeyword',
          'usageCount',
          'reviewCount',
          'isMastered',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'arabicWord',
          'normalizedWord',
          'englishMeaning',
          'transliteration',
          'root',
          'partOfSpeech',
          'contextSentenceArabic',
          'contextSentenceEnglish',
          'visualKeyword',
          'usageCount',
          'reviewCount',
          'isMastered',
          'createdAt',
          'updatedAt'
        ])
        && data.userId is string
        && data.userId.size() >= 1
        && data.userId.size() <= 128
        && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId == request.auth.uid
        && data.arabicWord is string
        && data.arabicWord.size() >= 1
        && data.arabicWord.size() <= 200
        && data.normalizedWord is string
        && data.normalizedWord.size() >= 1
        && data.normalizedWord.size() <= 200
        && data.englishMeaning is string
        && data.englishMeaning.size() >= 1
        && data.englishMeaning.size() <= 500
        && data.transliteration is string
        && data.transliteration.size() >= 1
        && data.transliteration.size() <= 200
        && data.root is string
        && data.root.size() >= 1
        && data.root.size() <= 100
        && data.partOfSpeech is string
        && data.partOfSpeech.size() >= 1
        && data.partOfSpeech.size() <= 64
        && data.contextSentenceArabic is string
        && data.contextSentenceArabic.size() >= 1
        && data.contextSentenceArabic.size() <= 1500
        && data.contextSentenceEnglish is string
        && data.contextSentenceEnglish.size() >= 1
        && data.contextSentenceEnglish.size() <= 1500
        && data.visualKeyword is string
        && data.visualKeyword.size() >= 1
        && data.visualKeyword.size() <= 300
        && data.usageCount is number
        && data.usageCount >= 0
        && data.usageCount <= 100000
        && data.reviewCount is number
        && data.reviewCount >= 0
        && data.reviewCount <= 100000
        && data.isMastered is bool
        && data.isMastered == (data.usageCount >= 20 && data.reviewCount >= 20)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserStats(data) {
      return data.keys().hasAll([
          'userId',
          'currentStreak',
          'longestStreak',
          'totalEntries',
          'totalWordsEncountered',
          'totalReviewsCompleted',
          'masteredWordsCount',
          'lastJournalDate',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'currentStreak',
          'longestStreak',
          'totalEntries',
          'totalWordsEncountered',
          'totalReviewsCompleted',
          'masteredWordsCount',
          'lastJournalDate',
          'updatedAt'
        ])
        && data.userId is string
        && data.userId.size() >= 1
        && data.userId.size() <= 128
        && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId == request.auth.uid
        && data.currentStreak is number
        && data.currentStreak >= 0
        && data.currentStreak <= 36500
        && data.longestStreak is number
        && data.longestStreak >= 0
        && data.longestStreak <= 36500
        && data.totalEntries is number
        && data.totalEntries >= 0
        && data.totalEntries <= 1000000
        && data.totalWordsEncountered is number
        && data.totalWordsEncountered >= 0
        && data.totalWordsEncountered <= 1000000
        && data.totalReviewsCompleted is number
        && data.totalReviewsCompleted >= 0
        && data.totalReviewsCompleted <= 10000000
        && data.masteredWordsCount is number
        && data.masteredWordsCount >= 0
        && data.masteredWordsCount <= 1000000
        && data.lastJournalDate is string
        && data.lastJournalDate.size() >= 1
        && data.lastJournalDate.size() <= 32
        && data.updatedAt is timestamp;
    }

    // 4. Collection Rules: /journalEntries/{entryId}
    match /journalEntries/{entryId} {
      allow get: if isSignedIn() && isValidId(entryId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;

      allow create: if isSignedIn()
        && isValidId(entryId)
        && isValidJournalEntry(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(entryId)
        && isValidJournalEntry(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'originalText',
            'fullArabicTranslation',
            'tokens',
            'updatedAt'
          ])
        );

      allow delete: if isSignedIn() && isValidId(entryId) && existing().userId == request.auth.uid;
    }

    // 5. Collection Rules: /wordBank/{wordId}
    match /wordBank/{wordId} {
      allow get: if isSignedIn() && isValidId(wordId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;

      allow create: if isSignedIn()
        && isValidId(wordId)
        && isValidWordBankItem(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(wordId)
        && isValidWordBankItem(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().normalizedWord == existing().normalizedWord
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'arabicWord',
            'englishMeaning',
            'transliteration',
            'root',
            'partOfSpeech',
            'contextSentenceArabic',
            'contextSentenceEnglish',
            'visualKeyword',
            'usageCount',
            'reviewCount',
            'isMastered',
            'updatedAt'
          ])
        );

      allow delete: if isSignedIn() && isValidId(wordId) && existing().userId == request.auth.uid;
    }

    // 6. Collection Rules: /userStats/{userId}
    match /userStats/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;

      allow create: if isSignedIn()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidUserStats(incoming())
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidUserStats(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'currentStreak',
            'longestStreak',
            'totalEntries',
            'totalWordsEncountered',
            'totalReviewsCompleted',
            'masteredWordsCount',
            'lastJournalDate',
            'updatedAt'
          ])
        );

      allow delete: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && existing().userId == request.auth.uid;
    }
  }
}
